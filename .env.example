# Square API
SQUARE_ACCESS_TOKEN=your_sandbox_token
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=your_location_id
SQUARE_APPLICATION_ID=your_application_id

# Square Internal API
SQUARE_UNIT_TOKEN=your_unit_token

# Slack
SLACK_WEBHOOK_URL=your_webhook_url

# PostHog
POSTHOG_API_KEY=your_posthog_key
POSTHOG_HOST=https://us.i.posthog.com

# Provider mode: 'mock' or 'square'
PROVIDER_MODE=mock

# Simulated payments: skip real card entry + Square charge so booking flows are
# testable. Honored only in local dev and Netlify previews/branch deploys; never production.
# DEV_BYPASS_PAYMENT=true

# Staff console shared passcode
# STAFF_PASSCODE=change-me

# Weekly custody-records archive (netlify/functions/archive-records.ts).
# ARCHIVE_TO: where the ZIP is emailed. Defaults to kaden@ourhometownstudio.com.
# ARCHIVE_DRY_RUN=1: write the ZIP to /tmp instead of emailing it (test runs).
# ARCHIVE_TO=kaden@ourhometownstudio.com
# ARCHIVE_DRY_RUN=1

# REQUIRED in production — signs the returning-customer reuse token issued
# after a waiver lookup's SMS code is verified (HOM-218). Without it,
# issueReuseToken/verifyReuseToken throw at first use in a production build
# rather than silently falling back to a hard-coded, non-secret value.
# LOOKUP_SIGNING_SECRET=change-me
