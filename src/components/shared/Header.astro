---
import { siteConfig } from '@config/site.config'
import { normalizePath } from '@lib/site-header'
import { buildNav, flatNav, navHoldsPath, type NavItem } from '@lib/nav'

// Grouped menu from site.config. Take Home Kits shows while kits are live
// (and always in local dev, where /kits is previewable).
const navItems = buildNav(siteConfig, { kitsVisible: siteConfig.features.kits.enabled || import.meta.env.DEV })

/** Craft colour for each offering's nav link (defined in global.css). */
const TONE_BY_HREF: Record<string, string> = {
  '/book': 'tone-party',
  '/workshops': 'tone-workshop',
  '/craft-cafe': 'tone-studio',
  '/calendar': 'tone-event',
  '/kits': 'tone-kit',
  '/private-events': 'tone-event',
}
/** A group takes its first page's colour ("Parties & Events" is the party pink). */
const toneOf = (item: NavItem) => TONE_BY_HREF[(item.href ?? item.children?.[0]?.href) as string]

// Normalize trailing slash so /programs/ matches nav href "/programs".
// Astro can serve some routes with a trailing slash even when others don't
// (depends on prerender + adapter), so exact-string match was fragile.
// The script below does the same after in-site navigation.
const currentPath = normalizePath(Astro.url.pathname)

// On /book these open the booking panel in place (the page listens for
// data-open-booking); everywhere else they are ordinary links to /book.
const opensBooking = normalizePath(siteConfig.navCta.href) === '/book'
---

<header id="site-header" class="header-root">
  <nav class="header-nav">
    <a href="/" class="header-brand">
      <img
        src={siteConfig.logo}
        alt=""
        class="header-logo"
        onerror="this.style.display='none';this.nextElementSibling.classList.remove('sr-only')"
      />
      {/* The banner logo already reads "Hometown Studio"; the text stays for
          screen readers, and comes back on screen if the image can't load. */}
      <span class="header-name sr-only">{siteConfig.name}</span>
    </a>

    {/* Desktop nav */}
    <ul class="header-links">
      {navItems.map((item, i) => item.children ? (
        <li class="nav-group">
          <button
            type="button"
            class:list={['header-link', 'nav-group-btn', toneOf(item), navHoldsPath(item, currentPath) && 'is-active']}
            aria-expanded="false"
            aria-controls={`nav-group-${i}`}
            data-nav-paths={flatNav(item.children).map((c) => c.href).join(' ')}
          >
            {item.label}
            <svg class="nav-chevron" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <div class="nav-panel" id={`nav-group-${i}`}>
            <ul class="nav-panel-list">
              {item.children.map((child) => (
                <li>
                  <a
                    href={child.href}
                    class:list={['nav-sub', toneOf(child), currentPath === child.href && 'is-active']}
                    aria-current={currentPath === child.href ? 'page' : undefined}
                  >
                    <span class="nav-sub-label">{child.label}</span>
                    {child.note && <span class="nav-sub-note">{child.note}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ) : (
        <li>
          <a
            href={item.href}
            class:list={[
              'header-link',
              toneOf(item),
              currentPath === item.href && 'is-active',
            ]}
            aria-current={currentPath === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    {siteConfig.navCta && (
      <a class="header-cta" href={siteConfig.navCta.href} data-open-booking={opensBooking}>{siteConfig.navCta.label}</a>
    )}

    {/* Mobile: booking button stays in view beside the menu */}
    {siteConfig.navCta && (
      <a class="header-cta-mobile" href={siteConfig.navCta.href} data-open-booking={opensBooking}>Book</a>
    )}

    {/* Mobile menu */}
    <div class="header-mobile">
      <button
        type="button"
        id="menu-button"
        class="header-burger"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="burger-line"></span>
        <span class="burger-line"></span>
      </button>

      <div id="mobile-menu" class="mobile-drawer">
        <ul class="mobile-links">
          {navItems.map((item) => item.children ? (
            <li class="mobile-group">
              <p class="mobile-group-label">{item.label}</p>
              <ul class="mobile-sublinks">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class:list={['mobile-link', toneOf(child), child.note && 'has-note', currentPath === child.href && 'is-active']}
                      aria-current={currentPath === child.href ? 'page' : undefined}
                    >
                      {child.label}
                      {child.note && <span class="mobile-note">{child.note}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                class:list={[
                  'mobile-link',
                  toneOf(item),
                  currentPath === item.href && 'is-active',
                ]}
                aria-current={currentPath === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a class="mobile-link mobile-link-cta" href={siteConfig.navCta.href} data-open-booking={opensBooking}>
              {siteConfig.navCta.label} <span aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>

<style>
  .header-root {
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background 0.4s ease, box-shadow 0.4s ease, backdrop-filter 0.4s ease;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .header-root.scrolled {
    background: rgba(250, 248, 245, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 1px 0 rgba(var(--color-primary-rgb), 0.08);
  }

  .header-nav {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.5rem;
  }

  /* Brand / logo */
  .header-brand {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    min-height: 2.75rem;
    gap: 0.75rem;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }
  .header-brand:hover {
    opacity: 0.7;
    text-decoration: none;
  }

  .header-logo {
    height: 2.75rem;
    width: auto;
  }

  .header-name {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-dark);
    white-space: nowrap;
  }

  /* Desktop links (≥1024px; below that the burger + Book pill carry the nav,
     because the links + the brand + the pill need ~870px even when tight —
     at 768–1023px they wrapped onto two lines and overflowed the screen) */
  .header-links {
    display: none;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 1024px) {
    .header-links { display: flex; }
  }
  /* iPad landscape (1024–1199px): the row fits only with a slightly smaller
     link size — the wide 0.08em tracking is what costs the space. */
  @media (min-width: 1024px) and (max-width: 1199px) {
    .header-links { gap: 1.1rem; }
    .header-link { font-size: 0.75rem; letter-spacing: 0.06em; }
  }

  .header-cta {
    display: none;
    flex-shrink: 0;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1.25rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-button-text);
    text-decoration: none;
    background: var(--color-button);
    box-shadow: 0 2px 10px rgba(var(--color-primary-rgb), 0.22);
    transition: background-color 0.2s ease, box-shadow 0.2s ease;
  }
  .header-cta:hover { background: var(--color-button-hover); text-decoration: none; }
  @media (min-width: 1024px) { .header-cta { display: inline-flex; } }

  /* Phones: a compact booking button that never hides in the menu */
  .header-cta-mobile {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-left: auto;
    margin-right: 0.375rem;
    padding: 0.4rem 1.1rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-button-text);
    text-decoration: none;
    background: var(--color-button);
  }
  .header-cta-mobile:hover { background: var(--color-button-hover); text-decoration: none; }
  @media (min-width: 1024px) { .header-cta-mobile { display: none; } }

  .header-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-muted);
    text-decoration: none;
    padding: 0.25rem 0;
    border-radius: 2px;
    transition: color 0.3s ease;
  }
  .header-link:hover {
    color: var(--color-dark);
    text-decoration: none;
  }
  .header-link.is-active {
    color: var(--color-dark);
  }

  /* Minimal underline — a thin line that slides in */
  .header-link::after {
    content: '';
    position: absolute;
    /* Just under the words, inside the 44px tap area. */
    bottom: 0.35rem;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: var(--tone, var(--color-primary));
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 0.4s cubic-bezier(0.25, 0.1, 0, 1);
  }
  .header-link:hover::after {
    transform: scaleX(1);
    transform-origin: left center;
  }
  .header-link.is-active::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  /* Menu groups (wide screens): the label is a button; its list drops below.
     It opens on a press, and on hover where there is a mouse (a touch screen's
     "hover" sticks, so iPads use the press only). */
  .nav-group {
    position: relative;
  }
  .nav-group-btn {
    gap: 0.3rem;
    border: 0;
    background: none;
    font-family: inherit;
    cursor: pointer;
  }
  .nav-chevron {
    width: 0.7rem;
    height: 0.7rem;
    transition: transform 0.25s ease;
  }
  .nav-group-btn[aria-expanded='true'] .nav-chevron {
    transform: rotate(180deg);
  }
  .nav-panel {
    position: absolute;
    top: 100%;
    left: 50%;
    z-index: 60;
    min-width: 21rem;
    padding: 0.5rem;
    border-radius: 1rem;
    border: 1px solid rgba(var(--color-primary-rgb), 0.1);
    background: rgba(250, 248, 245, 0.98);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 16px 40px rgba(var(--color-primary-rgb), 0.16);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 6px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
  }
  .nav-group-btn[aria-expanded='true'] + .nav-panel {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
  @media (hover: hover) {
    .nav-group:hover .nav-panel {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0);
    }
  }
  .nav-panel-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }
  .nav-sub {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.1rem;
    min-height: 2.75rem;
    padding: 0.55rem 0.85rem;
    border-radius: 0.65rem;
    border-left: 3px solid transparent;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .nav-sub:hover,
  .nav-sub.is-active {
    background: rgba(var(--color-primary-rgb), 0.06);
    border-left-color: var(--tone, var(--color-primary));
    text-decoration: none;
  }
  .nav-sub-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-dark);
  }
  .nav-sub-note {
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--color-muted);
  }

  /* Mobile burger — two lines that morph to X */
  .header-mobile {
    display: block;
  }
  @media (min-width: 1024px) {
    .header-mobile { display: none; }
  }

  /* 44px to tap; the negative margin keeps the lines where they always sat. */
  .header-burger {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.375rem;
    padding: 0;
    border: 0;
    border-radius: 0.5rem;
    background: none;
    cursor: pointer;
    gap: 6px;
  }

  .burger-line {
    display: block;
    width: 1.25rem;
    height: 1.5px;
    background: var(--color-dark);
    border-radius: 1px;
    transition: transform 0.4s cubic-bezier(0.25, 0.1, 0, 1), opacity 0.3s ease;
  }

  /* Burger to X */
  .header-burger[aria-expanded='true'] .burger-line:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }
  .header-burger[aria-expanded='true'] .burger-line:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  /* Mobile drawer */
  .mobile-drawer {
    position: absolute;
    top: 4.5rem;
    left: 0;
    right: 0;
    background: rgba(250, 248, 245, 0.92);
    backdrop-filter: blur(32px) saturate(1.4);
    -webkit-backdrop-filter: blur(32px) saturate(1.4);
    border-bottom: 1px solid rgba(var(--color-primary-rgb), 0.08);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.25, 0.1, 0, 1), visibility 0.35s ease;
  }
  .header-burger[aria-expanded='true'] ~ .mobile-drawer {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .mobile-links {
    list-style: none;
    margin: 0;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 1rem 0;
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    border-bottom: 1px solid rgba(var(--color-primary-rgb), 0.06);
    transition: color 0.3s ease;
  }
  .mobile-link:hover {
    color: var(--color-dark);
    text-decoration: none;
  }
  .mobile-link.is-active {
    color: var(--color-dark);
  }
  .mobile-link.has-note {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.2rem;
    padding: 0.75rem 0;
  }
  .mobile-note {
    font-size: 0.8rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-muted);
  }
  .mobile-group-label {
    margin: 1rem 0 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
  .mobile-links > li:first-child .mobile-group-label {
    margin-top: 0;
  }
  .mobile-sublinks {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.75rem;
  }
  .mobile-link-cta {
    gap: 0.35rem;
    color: var(--color-primary);
    font-weight: 600;
  }
  .mobile-links > li:last-child > .mobile-link {
    border-bottom: none;
  }
</style>

<script>
  import { initSiteHeader } from '@lib/site-header'

  // Runs once per visit. It listens on the document, so it carries on working
  // after in-site navigation (see src/lib/site-header.ts).
  initSiteHeader()
</script>
