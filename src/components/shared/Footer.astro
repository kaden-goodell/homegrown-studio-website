---
import { siteConfig } from '@config/site.config'
import { OPEN_STUDIO_START_DATE } from '@config/opening'

interface NavItem {
  label: string
  href: string
}

let navItems: NavItem[]

if (siteConfig.nav && siteConfig.nav.length > 0) {
  navItems = siteConfig.nav
} else {
  navItems = [
    { label: 'Home', href: '/' },
    { label: 'About', href: '/about' },
  ]
  if (siteConfig.features.workshops) {
    navItems.push({ label: 'Workshops', href: '/workshops' })
  }
  if (siteConfig.features.parties.enabled) {
    navItems.push({ label: 'Book a Party', href: '/book' })
  }
  if (siteConfig.features.gallery) {
    navItems.push({ label: 'Gallery', href: '/gallery' })
  }
}

// Kits joins the nav when the feature is live (or in local dev, where the
// /kits page is always previewable) — inserted after "Parties".
if (siteConfig.features.kits.enabled || import.meta.env.DEV) {
  const partiesIdx = navItems.findIndex((i) => i.href === '/book')
  navItems = [
    ...navItems.slice(0, partiesIdx + 1),
    { label: 'Take-Home Kits', href: '/kits' },
    ...navItems.slice(partiesIdx + 1),
  ]
}

// Walk-ins start later than the grand opening. Copy that depends on it is
// rendered both ways, tagged data-walkin="before" | "after", and the script at
// the bottom shows the right one. Build time picks the default; the script
// corrects it on the day, so prerendered pages don't need a deploy to switch.
const walkInOpen = new Date() >= new Date(OPEN_STUDIO_START_DATE + 'T00:00:00-06:00')

const currentYear = new Date().getFullYear()
const { street, city, state, zip } = siteConfig.address
const directionsUrl = `https://maps.google.com/?q=${encodeURIComponent(`${siteConfig.name}, ${street}, ${city}, ${state} ${zip}`)}`
const phoneDigits = (siteConfig.contactPhone ?? '').replace(/[^+\d]/g, '')
---

<footer class="site-footer">
  <div class="footer-inner">
    <a href="/" class="footer-logo-link">
      <img src={siteConfig.logoOnDark} alt="" class="footer-logo" width="51" height="36" />
      <span class="footer-name">{siteConfig.name}</span>
    </a>

    <div class="footer-columns">
      <div class="footer-column">
        <h2 class="footer-heading">Visit</h2>
        <p class="footer-text">
          {street}<br />
          {city}, {state} {zip}
        </p>
        <a href={directionsUrl} class="footer-link" rel="noopener" target="_blank">Get directions</a>
      </div>

      <div class="footer-column footer-column-middle">
        <h2 class="footer-heading">Hours</h2>
        <dl class="footer-hours">
          {siteConfig.hours.map((h) => (
            <div class="footer-hours-row">
              <dt>{h.days}</dt>
              <dd>{h.time}</dd>
            </div>
          ))}
        </dl>
        <p class="footer-note" data-walkin="before" hidden={walkInOpen}>
          Craft Café walk-ins are Saturday mornings from November 7. Parties and workshops by booking.
        </p>
      </div>

      <div class="footer-column footer-column-end">
        <h2 class="footer-heading">Contact</h2>
        {siteConfig.contactPhone && (
          <a href={`sms:${phoneDigits}`} class="footer-link">Text us at {siteConfig.contactPhone}</a>
        )}
        <a href={`mailto:${siteConfig.contactEmail}`} class="footer-link">{siteConfig.contactEmail}</a>
      </div>
    </div>

    <!-- One row of links, all the way across: the pages on the left, the small print on the right. -->
    <div class="footer-base">
      <nav class="footer-nav" aria-label="Footer">
        {navItems.map((item) => (
          <a href={item.href} class="footer-link">{item.label}</a>
        ))}
      </nav>
      <nav class="footer-nav" aria-label="Policies">
        <a href="/policies" class="footer-link">Policies</a>
        <a href="/waiver" class="footer-link">Participation agreement</a>
      </nav>
    </div>
    <p class="footer-copyright">&copy; {currentYear} {siteConfig.name}</p>
  </div>
</footer>

<script is:inline data-astro-rerun define:vars={{ walkInStart: OPEN_STUDIO_START_DATE }}>
  // Central time, standard offset: the Craft Café start date (see opening.ts).
  var walkInOpen = new Date() >= new Date(walkInStart + 'T00:00:00-06:00')
  document.querySelectorAll('[data-walkin]').forEach(function (el) {
    el.hidden = (el.getAttribute('data-walkin') === 'after') !== walkInOpen
  })
</script>

<style>
  /* A dark band, so the page has a clear end. Three columns say where, when
     and how to reach us; the page links sit quietly underneath. */
  .site-footer {
    margin-top: 4rem;
    padding: 0 1.5rem;
    background: var(--color-dark);
    color: var(--color-on-dark-muted);
  }

  .footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 3rem 0 1.5rem;
  }

  /* Brand */
  .footer-logo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    border-radius: 2px;
    text-decoration: none;
  }
  .footer-logo-link:hover {
    text-decoration: none;
  }

  .footer-logo {
    width: auto;
    height: 3rem;
    flex-shrink: 0;
  }

  .footer-name {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: var(--color-on-dark);
  }

  /* Columns */
  .footer-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 2rem 0 2.25rem;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  /* Side by side: Visit sits at the left edge, Hours in the middle, Contact
     at the right edge. Equal outer columns keep Hours truly centred. */
  @media (min-width: 720px) {
    .footer-columns {
      grid-template-columns: 1fr auto 1fr;
      gap: 3rem;
    }
    .footer-column-middle {
      align-items: center;
      text-align: center;
    }
    .footer-column-end {
      align-items: flex-end;
      text-align: right;
    }
  }

  .footer-heading {
    margin: 0 0 0.5rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-on-dark);
  }

  .footer-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-on-dark-muted);
  }

  .footer-note {
    margin: 0.625rem 0 0;
    max-width: 19rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-on-dark-muted);
  }

  /* Every link is 44px tall to tap (2.75rem). */
  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    border-radius: 2px;
    font-size: 0.9375rem;
    color: var(--color-on-dark);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .footer-link:hover {
    color: var(--color-on-dark);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .footer-link:focus-visible,
  .footer-logo-link:focus-visible {
    outline-color: var(--color-on-dark);
  }

  /* With a mouse there is no need for finger-sized rows: sit them closer. */
  @media (hover: hover) and (pointer: fine) {
    .footer-link {
      min-height: 2.125rem;
    }
  }

  /* Hours */
  .footer-hours {
    margin: 0;
    width: 17rem;
    max-width: 100%;
    text-align: left;
  }

  .footer-hours-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.175rem 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-on-dark-muted);
  }
  .footer-hours-row dt,
  .footer-hours-row dd {
    margin: 0;
  }
  .footer-hours-row dd {
    white-space: nowrap;
  }

  /* The quiet part: one row of links across the bottom, then the small print. */
  .footer-base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line-on-dark);
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }

  .footer-copyright {
    margin: 0;
    padding: 0.75rem 0 0;
    font-size: 0.8125rem;
    color: var(--color-on-dark-muted);
  }
</style>
