---
/**
 * Analytics loaders — included by both layouts so static pages (about,
 * policies) get pageviews too, not just the app pages.
 *
 * PostHog initializes once in src/components/posthog.astro. GA4 exists for
 * Google Ads conversion import (HOM-150); PUBLIC_GA4_ID is the "G-XXXXXXX"
 * measurement id from the GA4 property.
 */
const ga4Id = import.meta.env.PUBLIC_GA4_ID || ''
---

{ga4Id && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
    <script is:inline define:vars={{ ga4Id }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', ga4Id);
    </script>
  </>
)}

{/* Source capture + lead / call-to-action clicks — always on (even before an
    analytics key exists, the visitor's source is remembered for bookings). */}
<script>
  import '@lib/analytics-auto'
</script>
