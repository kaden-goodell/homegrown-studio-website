---
import { ViewTransitions } from 'astro:transitions'
import { siteConfig } from '@config/site.config'
import Header from '@components/shared/Header.astro'
import Footer from '@components/shared/Footer.astro'
import Analytics from '@components/shared/Analytics.astro'
import PostHog from '@components/posthog.astro'
import SeoHead from '@components/shared/SeoHead.astro'
import Shimmer from '@components/shared/Shimmer'
import RenameNotice from '@components/shared/RenameNotice'
import '@styles/global.css'
import '@styles/textures.css'
import '@styles/animations.css'

interface Props {
  title?: string
  /** The whole title, used as is (the homepage leads with the business name). */
  fullTitle?: string
  description?: string
  /** Link-preview overrides. Default to the page title and the branded image. */
  ogTitle?: string
  ogImage?: string
  /** Path and query a shared link should keep, e.g. "/workshops?w=abc". */
  shareUrl?: string
  /** Keep the page out of search results. */
  noindex?: boolean
  /** Extra structured data for this page. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  /**
   * Drop the marketing chrome — no header/nav, no footer, no shimmer — and
   * keep only the global styles, fonts and theme tokens. For staff tools on
   * the counter iPad: the fixed site nav sat on top of the console's sheet
   * headers, and tapping a sheet's "Close" landed on the nav's "Parties" link
   * and navigated the iPad off the console mid-pickup (F1).
   */
  bare?: boolean
}

const { bare } = Astro.props
const { colors, fonts, textures } = siteConfig.theme
const textureClass = `texture-${textures.background}`

const headingFont = fonts.heading.replace(/ /g, '+')
const bodyFont = fonts.body.replace(/ /g, '+')
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead {...Astro.props} />
    <PostHog noRecording={!!bare || Astro.url.pathname.startsWith('/waiver')} />
    <ViewTransitions />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href={`https://fonts.googleapis.com/css2?family=${headingFont}:wght@400;500;600;700&display=swap`}
      rel="stylesheet"
    />
    <link
      href={`https://fonts.googleapis.com/css2?family=${bodyFont}:wght@400;500;600;700&display=swap`}
      rel="stylesheet"
    />
    <style
      define:vars={{
        'color-primary': colors.primary,
        'color-secondary': colors.secondary,
        'color-accent': colors.accent,
        'color-background': colors.background,
        'color-text': colors.text,
        'color-muted': colors.muted,
        'font-heading': `'${fonts.heading}', serif`,
        'font-body': `'${fonts.body}', sans-serif`,
      }}
    >
      body {
        font-family: var(--font-body);
        color: var(--color-text);
      }
      h1, h2, h3, h4, h5, h6,
      .font-heading {
        font-family: var(--font-heading);
      }
    </style>
  </head>
  <body class={bare ? undefined : textureClass}>
    {!bare && <Shimmer enabled={siteConfig.theme.animations.particles} client:idle transition:persist />}
    {!bare && <Header transition:persist />}
    {/* `transition:animate` tags <main> with a view-transition-name, and the
        UA stylesheet gives tagged elements `contain: layout` — which makes
        <main> the containing block for every `position: fixed` descendant.
        That is what put the console's full-screen sheets inside the page
        column instead of over the viewport (F1), so a bare page skips it. */}
    {bare ? (
      <main>
        <slot />
      </main>
    ) : (
      <main transition:animate="fade">
        <slot />
      </main>
    )}
    {!bare && <Footer transition:persist />}
    {!bare && <RenameNotice client:idle transition:persist />}
    <script>import '@lib/fade-in'</script>
    {/* Staff tools (the console, the counter-iPad agreement) aren't visitors. */}
    {!bare && <Analytics />}
  </body>
</html>
