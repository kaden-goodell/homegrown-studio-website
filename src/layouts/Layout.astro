---
import { ViewTransitions } from 'astro:transitions'
import { siteConfig } from '@config/site.config'
import Header from '@components/shared/Header.astro'
import Footer from '@components/shared/Footer.astro'
import Analytics from '@components/shared/Analytics.astro'
import Shimmer from '@components/shared/Shimmer'
import '@styles/global.css'
import '@styles/textures.css'
import '@styles/animations.css'

interface Props {
  title?: string
  description?: string
  /** Social-share overrides. Default to the page title/description. */
  ogTitle?: string
  ogImage?: string
  /** Keep this page out of search engines (staff-only tools, internal pages). */
  noindex?: boolean
  /**
   * Drop the marketing chrome — no header/nav, no footer, no shimmer — and
   * keep only the global styles, fonts and theme tokens. For staff tools on
   * the counter iPad: the fixed site nav sat on top of the console's sheet
   * headers, and tapping a sheet's "Close" landed on the nav's "Parties" link
   * and navigated the iPad off the console mid-pickup (F1).
   */
  bare?: boolean
}

const { title, description, ogTitle, ogImage, noindex, bare } = Astro.props
const pageTitle = title ? `${title} | ${siteConfig.name}` : siteConfig.name
const pageDescription = description || siteConfig.tagline
const shareTitle = ogTitle || pageTitle
const shareImage = ogImage || '/images/party-hero.jpg'
const { colors, fonts, textures } = siteConfig.theme
const textureClass = `texture-${textures.background}`

const headingFont = fonts.heading.replace(/ /g, '+')
const bodyFont = fonts.body.replace(/ /g, '+')
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{pageTitle}</title>
    {/* Link-preview (OpenGraph + Twitter) — makes shared invites unfurl richly. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={shareImage} />
    <ViewTransitions />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href={`https://fonts.googleapis.com/css2?family=${headingFont}:wght@400;500;600;700&display=swap`}
      rel="stylesheet"
    />
    <link
      href={`https://fonts.googleapis.com/css2?family=${bodyFont}:wght@400;500;600;700&display=swap`}
      rel="stylesheet"
    />
    <style
      define:vars={{
        'color-primary': colors.primary,
        'color-secondary': colors.secondary,
        'color-accent': colors.accent,
        'color-background': colors.background,
        'color-text': colors.text,
        'color-muted': colors.muted,
        'font-heading': `'${fonts.heading}', serif`,
        'font-body': `'${fonts.body}', sans-serif`,
      }}
    >
      body {
        font-family: var(--font-body);
        color: var(--color-text);
      }
      h1, h2, h3, h4, h5, h6,
      .font-heading {
        font-family: var(--font-heading);
      }
    </style>
  </head>
  <body class={bare ? undefined : textureClass}>
    {!bare && <Shimmer enabled={siteConfig.theme.animations.particles} client:load transition:persist />}
    {!bare && <Header transition:persist />}
    {/* `transition:animate` tags <main> with a view-transition-name, and the
        UA stylesheet gives tagged elements `contain: layout` — which makes
        <main> the containing block for every `position: fixed` descendant.
        That is what put the console's full-screen sheets inside the page
        column instead of over the viewport (F1), so a bare page skips it. */}
    {bare ? (
      <main>
        <slot />
      </main>
    ) : (
      <main transition:animate="fade">
        <slot />
      </main>
    )}
    {!bare && <Footer transition:persist />}
    <script>import '@lib/fade-in'</script>
    <Analytics />
  </body>
</html>
