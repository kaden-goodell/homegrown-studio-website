---
export const prerender = false

import Layout from '@layouts/Layout.astro'
import PartyLanding from '@components/party/PartyLanding'
import RecentPartyBanner from '@components/party/RecentPartyBanner'
import PartyFaq from '@components/party/PartyFaq.astro'
import { partyContent } from '@config/party-content'
import { siteConfig } from '@config/site.config'
import { envBookingsOpen, previewToken, hasValidPreviewCookie, previewQueryMatches, previewCookieName } from '@lib/bookings-gate'

const { hero, deposit } = partyContent
const kitsLive = siteConfig.features.kits.enabled

// Pre-opening gate: hide the live booking flow from the public; owner can preview
// with ?preview=<PREVIEW_TOKEN> (drops a cookie that unlocks this browser).
const _previewMatch = previewQueryMatches(Astro.url)
if (_previewMatch) {
  Astro.cookies.set(previewCookieName, previewToken(), { path: '/', httpOnly: true, sameSite: 'lax', maxAge: 60 * 60 * 24 * 30 })
}
const bookingsOpen = envBookingsOpen() || _previewMatch || hasValidPreviewCookie(Astro.request)
---

<Layout title="Book a Party">
  <RecentPartyBanner client:load />
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-28">
    <div class="text-center mb-16 fade-in">
      <p class="eyebrow tone-party mb-3">
        {hero.eyebrow}
      </p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-bold" style="color: var(--color-dark);">
        {hero.headline}
      </h1>
      <p class="mt-4 text-sm font-medium tracking-wide" style="color: var(--color-primary);">
        {hero.occasions}
      </p>
      {hero.heroImage && (
        <img
          src={hero.heroImage}
          alt={hero.heroImageAlt}
          class="mt-8 mx-auto rounded-2xl w-full max-w-3xl object-cover"
          style="aspect-ratio: 21 / 9; box-shadow: 0 24px 60px rgba(var(--color-primary-rgb), 0.18);"
        />
      )}
      <p class="text-lg mt-6 max-w-xl mx-auto" style="color: var(--color-muted);">
        {hero.subline}
      </p>
      <div class="mt-5 flex flex-wrap justify-center gap-2">
        {hero.valueTrio.map((item) => (
          <span
            class="chip tone-party"
            style="padding: 0.4rem 0.9rem;"
          >
            {item}
          </span>
        ))}
      </div>
      <p class="mt-6 text-sm font-semibold" style="color: var(--color-dark);">
        {deposit.holdLine}
      </p>
      {bookingsOpen && (
        <a
          href="#open-dates"
          class="btn btn-primary mt-5"
        >
          See open dates
        </a>
      )}
    </div>
    {bookingsOpen ? (
      <PartyLanding client:load />
    ) : (
      <div
        class="text-center max-w-xl mx-auto rounded-2xl px-8 py-14"
        style="background: rgba(var(--color-primary-rgb), 0.06); border: 1px solid rgba(var(--color-primary-rgb), 0.14);"
      >
        <p class="eyebrow tone-party mb-3">Opening Soon</p>
        <h2 class="text-2xl sm:text-3xl font-heading font-bold" style="color: var(--color-dark);">
          Online booking opens closer to our grand opening
        </h2>
        <p class="mt-4 text-base" style="color: var(--color-muted);">
          We’re putting the finishing touches on the studio. Follow along and you’ll be the first to know when party dates open.
        </p>
        <a
          href="/calendar"
          class="btn btn-primary mt-6"
        >
          See what’s on
        </a>
      </div>
    )}
    <div class="glass rounded-2xl px-8 py-10 sm:px-12 text-center mt-16 fade-in">
      <p class="eyebrow tone-kit mb-3">
        {kitsLive ? 'New' : 'Coming Soon'}
      </p>
      <h2 class="text-2xl sm:text-3xl font-heading font-bold mb-3" style="color: var(--color-dark);">Take-Home Party Kits</h2>
      <p class="text-base max-w-xl mx-auto leading-relaxed" style="color: var(--color-muted);">
        {kitsLive
          ? 'Want the party without booking the studio? A themed craft kit for your crew, styled table and all — pick up Thursday, host at home.'
          : 'Want the party without booking the studio? We’re boxing up themed craft kits — gold, silver, rainbow, and more — so you can host at home. Join the newsletter and you’ll be the first to know.'}
      </p>
      {kitsLive && (
        <a
          href="/kits"
          class="btn btn-primary mt-6"
        >
          Build your kit
        </a>
      )}
    </div>
    <PartyFaq />
  </section>
</Layout>
