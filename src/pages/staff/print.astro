---
export const prerender = false

import { staffAuthorized } from '@lib/staff-auth'
import { getEvent, resolveEventDay, EVENT_KIND_RE } from '@lib/events'
import { listWaiversByEvent } from '@lib/waiver-store'
import { effectivePickup } from '@lib/pickup'
import { formatWhen, formatCalendarDay } from '@lib/studio-time'
import { listSeatChoicesByEvent, summarizeChoices } from '@lib/seat-choices'
import { picksShort, totalsLine } from '@lib/seat-options'
import { siteConfig } from '@config/site.config'

// Staff-authed server-side (HOM-213) — a printable paper fallback for the
// door when wifi drops, so it must never be reachable without the same
// staff cookie the console itself requires.
if (!staffAuthorized(Astro.request)) {
  return new Response('Unauthorized — sign in at /staff first.', { status: 401 })
}

// Rosters only ever exist for these two kinds (programs have no resolver
// yet) — matches the narrowing `roster.json.ts`/`sign.json.ts` use for the
// same reason.
type RosterKind = 'party' | 'workshop'
const KIND_RE = EVENT_KIND_RE
const rawKind = Astro.url.searchParams.get('kind') ?? ''
const rawId = Astro.url.searchParams.get('id') ?? ''
const kind = KIND_RE.test(rawKind) ? (rawKind as RosterKind) : null
const id = rawId.trim()

const event = kind && id ? await getEvent(kind, id) : null
const day = event ? resolveEventDay(event, Astro.url.searchParams.get('day')) : null

const waivers = event && kind ? await listWaiversByEvent(kind, id) : []
waivers.sort((a, b) => `${a.adult.firstName} ${a.adult.lastName}`.localeCompare(`${b.adult.firstName} ${b.adult.lastName}`))

// Seat picks (spec D): only classes that ask questions have them. A failed
// read must never blank the paper fallback — print without picks and say so.
const options = kind === 'workshop' && event ? (event.options ?? []) : []
let choices: ReturnType<typeof summarizeChoices> | null = null
let picksUnavailable = false
if (event && options.length > 0) {
  try {
    choices = summarizeChoices(
      options,
      await listSeatChoicesByEvent('workshop', id),
      waivers.map((w) => w.adult.email),
      typeof event.capacity === 'number' && typeof event.seats === 'number' ? event.capacity - event.seats : null,
    )
  } catch (err) {
    console.error('[staff/print] seat choices read failed', err)
    picksUnavailable = true
  }
}

interface PrintRow {
  household: string
  phone: string
  person: string
  role: string
  allergies: string
  medications: string
  emergency: string
  authorizedPickup: string
  notAuthorized: string
  picks: string
}

const rows: PrintRow[] = []
for (const w of waivers) {
  // Same resolver the door gate uses, so paper never disagrees with the iPad
  // (and a "None" clear never prints as a restriction).
  const { authorizedPickup, notAuthorized } = await effectivePickup({ waiver: w })
  const emergency = w.emergency.name ? `${w.emergency.name} · ${w.emergency.phone}${w.emergency.relationship ? ` (${w.emergency.relationship})` : ''}` : '— (call the signer)'
  const pickupText = authorizedPickup.length > 0
    ? authorizedPickup.map((p) => (p.phone ? `${p.name} (${p.phone})` : p.name)).join(', ')
    : '— not provided —'
  const household = `${w.adult.firstName} ${w.adult.lastName}`.trim()

  rows.push({
    household, phone: w.adult.phone, person: household, role: 'Adult',
    allergies: w.adult.allergies || '', medications: '',
    emergency, authorizedPickup: pickupText, notAuthorized,
    picks: choices ? picksShort(choices.byEmail[w.adult.email.trim().toLowerCase()] ?? []) : '',
  })
  w.minors.forEach((m) => {
    rows.push({
      household, phone: w.adult.phone, person: m.name, role: 'Child',
      allergies: m.allergies || '', medications: m.medications || '',
      emergency, authorizedPickup: pickupText, notAuthorized, picks: '',
    })
  })
}

const origin = siteConfig.url
const title = event ? `${event.title} — Roster` : 'Roster not found'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} | {siteConfig.name}</title>
    <style>
      :root { color-scheme: light; }
      * { box-sizing: border-box; }
      body {
        font-family: -apple-system, Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 1.25rem;
        color: #1f2937;
        background: #fff;
      }
      header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 0.9rem;
        flex-wrap: wrap;
      }
      h1 { font-size: 1.25rem; margin: 0 0 0.2rem; }
      .meta { color: #4b5563; font-size: 0.875rem; margin: 0; }
      .no-print button {
        padding: 0.5rem 0.9rem;
        border-radius: 0.5rem;
        border: 1px solid #7a4a2e;
        background: #7a4a2e;
        color: #fff;
        font-weight: 600;
        font-size: 0.875rem;
        cursor: pointer;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.75rem;
      }
      th, td {
        border: 1px solid #d1d5db;
        padding: 0.35rem 0.45rem;
        text-align: left;
        vertical-align: top;
      }
      th {
        background: #f3f4f6;
        font-weight: 700;
      }
      .blank-col { width: 4.5rem; }
      .picks-col { max-width: 6rem; overflow-wrap: anywhere; }
      .household-start td { border-top: 2px solid #9ca3af; }
      .not-authorized { color: #b91c1c; font-weight: 700; }
      .empty { color: #6b7280; padding: 2rem 0; text-align: center; }

      @media print {
        .no-print { display: none; }
        body { padding: 0; }
        @page { size: letter; margin: 0.5in; }
      }
    </style>
  </head>
  <body>
    <header>
      <div>
        <h1>{title}</h1>
        {event && (
          <p class="meta">
            {formatWhen(event.startIso)}
            {day && <> · {formatCalendarDay(day)}</>}
            {event.dropOff && <> · DROP-OFF EVENT</>}
          </p>
        )}
        {choices && options.map((o) => (
          <p class="meta">
            <strong>{totalsLine(o, choices.totals[o.id] ?? {})}</strong>
            {choices.seatsSold !== null && <> ({choices.seatsSold} seats sold)</>}
          </p>
        ))}
        {picksUnavailable && <p class="meta">Picks unavailable</p>}
        <p class="meta">{origin}/staff</p>
      </div>
      <div class="no-print">
        <button type="button" id="print-btn">🖨 Print</button>
      </div>
    </header>

    {!event ? (
      <p class="empty">Couldn’t find that event — check the link and try again.</p>
    ) : rows.length === 0 ? (
      <p class="empty">No signed households yet.</p>
    ) : (
      <table>
        <thead>
          <tr>
            <th>Household</th>
            <th>Person</th>
            {choices && <th class="picks-col">Picks</th>}
            <th>Allergies</th>
            <th>Medications</th>
            <th>Emergency contact</th>
            <th>Authorized pickup</th>
            <th>May NOT collect</th>
            <th class="blank-col">In</th>
            <th class="blank-col">Out</th>
            <th class="blank-col">Collected by</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r, i) => (
            <tr class={i === 0 || rows[i - 1].household !== r.household ? 'household-start' : ''}>
              <td>{r.household}<br />{r.phone}</td>
              <td>{r.person} <em>({r.role})</em></td>
              {choices && <td class="picks-col">{r.picks}</td>}
              <td>{r.allergies}</td>
              <td>{r.medications}</td>
              <td>{r.emergency}</td>
              <td>{r.authorizedPickup}</td>
              <td class={r.notAuthorized ? 'not-authorized' : ''}>{r.notAuthorized}</td>
              <td class="blank-col"></td>
              <td class="blank-col"></td>
              <td class="blank-col"></td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    {choices && choices.unmatched.length > 0 && (
      <>
        <h2 style="font-size: 1rem; margin: 1rem 0 0.4rem;">Paid or comped, not signed in yet</h2>
        <ul style="margin: 0; padding-left: 1.1rem; font-size: 0.8125rem;">
          {choices.unmatched.map((u) => (
            <li>{u.name} · {u.seats} seat{u.seats === 1 ? '' : 's'}{u.picks.length > 0 && <> · Picks: {picksShort(u.picks)}</>}{u.comped && ' · comped'}</li>
          ))}
        </ul>
      </>
    )}

    <script>
      document.getElementById('print-btn')?.addEventListener('click', () => window.print())
    </script>
  </body>
</html>
