---
export const prerender = false

import Layout from '@layouts/Layout.astro'
import WorkshopExplorer from '@components/workshops/WorkshopExplorer'
import { envBookingsOpen, previewToken, hasValidPreviewCookie, previewQueryMatches, previewCookieName } from '@lib/bookings-gate'

// Workshops are fetched client-side (via /api/workshops.json) so this page renders
// instantly instead of blocking navigation on the (sometimes slow) Square Classes API.

// Pre-opening gate: hide the live booking flow from the public; owner can preview
// with ?preview=<PREVIEW_TOKEN> (drops a cookie that unlocks this browser).
const _previewMatch = previewQueryMatches(Astro.url)
if (_previewMatch) {
  Astro.cookies.set(previewCookieName, previewToken(), { path: '/', httpOnly: true, sameSite: 'lax', maxAge: 60 * 60 * 24 * 30 })
}
const bookingsOpen = envBookingsOpen() || _previewMatch || hasValidPreviewCookie(Astro.request)
---

<Layout title="Workshops">
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-28">
    <div class="text-center mb-16 fade-in">
      <p class="eyebrow tone-workshop mb-3">Upcoming</p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-bold" style="color: var(--color-dark);">Workshops</h1>
      <p class="text-lg mt-4 max-w-xl mx-auto" style="color: var(--color-muted);">
        Guided crafting sessions, everything included — grab a seat before they fill up. Want the full picture? <a href="/calendar" class="underline" style="color: var(--color-primary);">See what's on</a>.
      </p>
    </div>
    {bookingsOpen ? (
      <WorkshopExplorer client:load />
    ) : (
      <div
        class="text-center max-w-xl mx-auto rounded-2xl px-8 py-14"
        style="background: rgba(var(--color-primary-rgb), 0.06); border: 1px solid rgba(var(--color-primary-rgb), 0.14);"
      >
        <p class="eyebrow tone-workshop mb-3">Opening Soon</p>
        <h2 class="text-2xl sm:text-3xl font-heading font-bold" style="color: var(--color-dark);">
          Workshop booking opens closer to our grand opening
        </h2>
        <p class="mt-4 text-base" style="color: var(--color-muted);">
          We’re almost ready. Check back soon — the first classes will be posted here.
        </p>
        <a
          href="/calendar"
          class="btn btn-primary mt-6"
        >
          See what’s on
        </a>
      </div>
    )}

    <!-- Adult nights positioning band (HOM-161) — evergreen copy, no invented listings. -->
    <div class="max-w-2xl mx-auto mt-20 text-center fade-in">
      <div class="glass rounded-2xl px-8 py-10 sm:px-12">
        <p class="eyebrow tone-workshop mb-3">
          Not just for kids
        </p>
        <h2 class="text-2xl md:text-3xl font-heading font-bold mb-4" style="color: var(--color-dark);">
          Workshops for adults, too
        </h2>
        <p class="text-base" style="color: var(--color-muted); line-height: 1.8;">
          Bring a friend, bring your mom, or come by yourself. Every workshop includes
          the materials and the teaching, so you just show up. New dates go up on the
          <a href="/calendar" class="underline" style="color: var(--color-primary);">calendar</a> as we add them.
        </p>
      </div>
    </div>
  </section>
</Layout>
