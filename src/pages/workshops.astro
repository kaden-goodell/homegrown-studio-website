---
export const prerender = false

import Layout from '@layouts/Layout.astro'
import WorkshopExplorer from '@components/workshops/WorkshopExplorer'
import NotifyMe from '@components/shared/NotifyMe'
import { providers } from '@config/providers'
import { partyConfig } from '@config/party.config'
import { OPENING_DATE } from '@config/opening'
import { longDate, workshopNotifyContext } from '@lib/notify-context'
import { summarize } from '@lib/seo'
import { formatMoney } from '@lib/money'
import { canBeBooked } from '@lib/workshop-rules'
import { siteConfig } from '@config/site.config'
import type { Workshop } from '@providers/interfaces/workshop'

const siteName = siteConfig.name
import { envBookingsOpen, previewToken, hasValidPreviewCookie, previewQueryMatches, previewCookieName } from '@lib/bookings-gate'

// Workshops are fetched client-side (via /api/workshops.json) so this page renders
// instantly instead of blocking navigation on the (sometimes slow) Square Classes API.

// Pre-opening gate: hide the live booking flow from the public; owner can preview
// with ?preview=<PREVIEW_TOKEN> (drops a cookie that unlocks this browser).
const _previewMatch = previewQueryMatches(Astro.url)
if (_previewMatch) {
  Astro.cookies.set(previewCookieName, previewToken(), { path: '/', httpOnly: true, sameSite: 'lax', maxAge: 60 * 60 * 24 * 30 })
}
const bookingsOpen = envBookingsOpen('workshops') || _previewMatch || hasValidPreviewCookie(Astro.request)

// A link to one workshop (?w=<id>, from the calendar or a shared link) should
// preview as that workshop, and while booking is closed the sign-up panel
// should name it. The lookup gets a short leash so a slow Square call can
// never hold up the page; on any failure both fall back to the page defaults.
const openingLabel = longDate(OPENING_DATE)
let tapped: Workshop | null = null
const wantedId = Astro.url.searchParams.get('w') ?? ''
if (/^[A-Za-z0-9_-]{6,64}$/.test(wantedId)) {
  try {
    tapped = await Promise.race([
      providers.workshop.getWorkshop(wantedId),
      new Promise<null>((resolve) => setTimeout(() => resolve(null), 1500)),
    ])
  } catch {
    tapped = null
  }
}
const { lookingAt, interest } = workshopNotifyContext(tapped, partyConfig.timezone)

// A workshop with no price yet is "Coming soon": its preview names no price.
const price = tapped && canBeBooked(tapped.priceCents) ? formatMoney(tapped.priceCents, tapped.priceCurrency) : ''
const preview = tapped
  ? {
      ogTitle: `${[lookingAt, price].filter(Boolean).join(' · ')} | ${siteName}`,
      description: summarize(tapped.description) || undefined,
      ogImage: tapped.imageUrl,
      shareUrl: `/workshops?w=${encodeURIComponent(tapped.id)}`,
    }
  : {}
---

<Layout
  title="Craft Workshops"
  description="Guided craft workshops in Madison, AL. Materials and teaching included. See dates and book a seat."
  {...preview}
>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-28">
    <div class="text-center mb-16 fade-in">
      <p class="eyebrow tone-workshop mb-3">Upcoming</p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-bold" style="color: var(--color-dark);">Workshops</h1>
      <p class="text-lg mt-4 max-w-xl mx-auto" style="color: var(--color-muted);">
        Guided craft workshops. Materials and teaching included. <a href="/calendar" class="underline" style="color: var(--color-primary);">See the calendar</a>.
      </p>
    </div>
    {bookingsOpen ? (
      <WorkshopExplorer client:load />
    ) : (
      <div class="notice-panel tone-workshop" id="notify">
        <p class="eyebrow mb-3">Opening soon</p>
        <h2 class="text-2xl sm:text-3xl font-heading font-bold" style="color: var(--color-dark);">
          Booking opens with our grand opening, planned for {openingLabel}
        </h2>
        <p class="mt-4 mb-6 text-base" style="color: var(--color-text);">
          {lookingAt && <Fragment>You were looking at <strong>{lookingAt}</strong>. </Fragment>}
          Leave your email and we’ll send one message the day seats go on sale.
        </p>
        <NotifyMe
          client:load
          interest={interest}
          successText="Got it. We’ll email you the day seats go on sale."
        />
        <p class="mt-6 text-sm">
          <a href="/calendar" class="underline" style="color: var(--color-primary);">See the calendar</a>
        </p>
      </div>
    )}

    <!-- Who workshops are for — evergreen copy, no invented listings. -->
    <div class="max-w-2xl mx-auto mt-20 text-center fade-in">
      <div class="glass rounded-2xl px-8 py-10 sm:px-12 tone-workshop">
        <p class="eyebrow mb-3">
          For everyone, ages 8 and up
        </p>
        <h2 class="text-2xl md:text-3xl font-heading font-bold mb-4" style="color: var(--color-dark);">
          Bring someone, or come on your own
        </h2>
        <p class="text-base" style="color: var(--color-muted); line-height: 1.8;">
          Come with a friend, your mom, or by yourself. Materials and teaching are
          included, so you just show up. New dates go up on the
          <a href="/calendar" class="underline" style="color: var(--color-primary);">calendar</a> as we add them.
        </p>
      </div>
    </div>
  </section>
</Layout>
