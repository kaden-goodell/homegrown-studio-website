---
/**
 * One-off private event quote for The Corky Child Care Collective (Kaden,
 * 17 Nov 2026), made by hand before the quote system ships. Invitation
 * design (canvas "C · The Invitation") with a "build your evening" picker:
 * each craft has a time and its price (no discounts, Kaden 17 Nov). The Hold button is a
 * fixed Square payment link for the deposit; final picks and names come in by
 * Nov 27 and the owners book the evening in /admin.
 */
import Layout from '@layouts/Layout.astro'

export const prerender = true

const DEPOSIT_URL = 'https://square.link/u/REPLACE_ME'
const DEPOSIT = '$1,500'
const EVENING_MINUTES = 165 // 5:30 to 8:30, less welcome and wrap-up
const img = (n: string) => `/quote/corky/${n}`

/** Times are placeholders until Kaden confirms; prices per guest, no discounts. */
const crafts = [
  { id: 'tote', name: 'Monogrammed tote', note: 'Her initials, patched her way', price: 35, minutes: 45, img: img('bag.jpg'), pick: true },
  { id: 'rondelle', name: 'Rondelle necklace', note: 'Strung bead by bead', price: 35, minutes: 30, img: img('rondelle.jpg'), pick: true },
  { id: 'keychain', name: 'Keychain bar', note: 'Scarves, bubble letters, beads and charms', price: 20, minutes: 20, img: img('scarf.jpg'), pick: true },
  { id: 'coasters', name: 'Mosaic coasters', note: 'A set of four in Christmas colors', price: 40, minutes: 45, img: img('p0640.jpg'), pick: false },
  { id: 'plants', name: 'Plant bar', note: 'A succulent in a pot you decoupage or mosaic', price: 20, minutes: 30, img: img('plants.jpg'), pick: false },
  { id: 'earrings', name: 'Christmas earrings', note: 'From our earring bar', price: 20, minutes: 20, img: img('p0632.jpg'), pick: false },
  { id: 'felt', name: 'Needle-felt ornament', note: 'Soft, small, for the tree', price: 8, minutes: 30, img: img('p0557.jpg'), pick: false },
]
---
<Layout
  title="A Christmas Evening of Making"
  description="Your evening at Hometown Studio, Saturday, December 12."
  noindex
  noAnalytics
  noReferrer
  bare
>
  <main class="inv">
    <div class="polaroids" aria-hidden="true">
      <img class="pol p1" src={img('rondelle.jpg')} alt="" />
      <img class="pol p2" src={img('bag.jpg')} alt="" />
      <img class="pol p3" src={img('scarf.jpg')} alt="" />
    </div>

    <section class="card">
      <div class="frame">
        <p class="kicker">Hometown Studio presents</p>
        <h1>A Christmas Evening of Making</h1>
        <svg class="rule" aria-hidden="true" width="120" height="14" viewBox="0 0 120 14" fill="none" stroke="#c4a882" stroke-width="1.2"><path d="M0 7h48M72 7h48" /><path d="M60 1l5 6-5 6-5-6z" /></svg>
        <p class="for">for the educators of<br />The Corky Child Care Collective</p>
        <p class="when">Saturday, December twelfth<br />half past five to half past eight<br />40 to 50 guests · at the studio</p>
      </div>
    </section>

    <p class="note">You take care of everyone all year.<br />This night, we take care of you.</p>

    <section class="build">
      <p class="kicker center">Build your evening</p>
      <p class="lede">Tap a craft to add it to your evening.</p>

      <div class="grid">
        {crafts.map((c) => (
          <button type="button" class="craft" data-id={c.id} data-name={c.name} data-price={c.price} data-minutes={c.minutes} aria-pressed={c.pick ? 'true' : 'false'}>
            <span class="ph"><img src={c.img} alt="" loading="lazy" /><span class="tick" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span></span>
            <span class="cname">{c.name}</span>
            <span class="cnote">{c.note}</span>
            <span class="cmeta"><span>{c.minutes} min</span><span>${c.price}</span></span>
          </button>
        ))}
      </div>
    </section>

    <section class="summary" aria-live="polite">
      <div class="time">
        <div class="time-row"><span>Crafting time</span><span><b id="mins">0</b> of {EVENING_MINUTES} min</span></div>
        <div class="bar"><div class="fill" id="fill"></div></div>
        <p class="over" id="over" hidden>That's more than fits in three hours. Drop one, or text us about a longer evening.</p>
      </div>
      <div class="price">
        <div class="row big"><span class="your">Per guest</span><span class="amt"><span id="price">$0</span><small> a guest</small></span></div>
        <p class="save" id="save"></p>
        <p class="picked" id="picked"></p>
      </div>
    </section>

    <section class="photos" aria-hidden="true">
      <img src={img('totes.jpg')} alt="" />
      <img src={img('rondelle2.jpg')} alt="" />
      <img src={img('p0031.jpg')} alt="" />
    </section>

    <section class="included">
      <div><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#7a4a2e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7" r="3.5" /><path d="M5 21c0-3.9 3.1-7 7-7s7 3.1 7 7" /></svg><span>Your own hosts</span></div>
      <div><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#7a4a2e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h10" /></svg><span>Every supply</span></div>
      <div><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#7a4a2e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12l3-3 4 4 8-8 3 3-11 11z" /></svg><span>We set up &amp; clean up</span></div>
      <div><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#7a4a2e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h16v11H4zM12 9v11M4 9l2-5h12l2 5" /></svg><span>Everything goes home</span></div>
    </section>

    <section class="steps">
      <p class="kicker center">How it works</p>
      <ol>
        <li><span><b>Hold your evening.</b> {DEPOSIT} today goes toward your total.</span></li>
        <li><span><b>Send picks and names by Friday, November 27.</b> Your crafts, your final count, and a monogram for each tote.</span></li>
        <li><span><b>Pay for who comes.</b> The rest is settled on the night.</span></li>
      </ol>
    </section>

    <section class="reserve">
      <p class="kicker light">Kindly reply by Tuesday, November 24</p>
      <p class="sum" id="sum">Your evening</p>
      <a class="btn" href={DEPOSIT_URL}>Hold December 12 · {DEPOSIT}</a>
      <a class="btn ghost" id="textpicks" href="sms:+12564641710">Text us my picks</a>
      <p class="fine">Totes are monogrammed to order, so names can't change once they're made. <a href="/policies">Our policies</a></p>
    </section>

    <footer class="sign">
      <p class="love">with love, Catherine &amp; Kaden</p>
      <p>Questions? <a href="sms:+12564641710">Text us at (256) 464-1710</a></p>
    </footer>
  </main>
</Layout>

<script define:vars={{ EVENING_MINUTES }}>
  const $ = (id) => document.getElementById(id)
  const cards = [...document.querySelectorAll('.craft')]
  const money = (n) => '$' + n.toLocaleString('en-US')

  function render() {
    const on = cards.filter((c) => c.getAttribute('aria-pressed') === 'true')
    const normal = on.reduce((s, c) => s + Number(c.dataset.price), 0)
    const minutes = on.reduce((s, c) => s + Number(c.dataset.minutes), 0)
    const price = normal
    $('mins').textContent = String(minutes)
    const pct = Math.min(100, (minutes / EVENING_MINUTES) * 100)
    $('fill').style.width = pct + '%'
    $('fill').classList.toggle('full', minutes > EVENING_MINUTES)
    $('over').hidden = minutes <= EVENING_MINUTES
    $('price').textContent = money(price)
    $('save').textContent = normal ? '' : 'Pick a craft or two to start.'
    const names = on.map((c) => c.dataset.name)
    $('picked').textContent = names.join(' · ')
    $('sum').textContent = on.length ? money(price) + ' a guest · ' + on.length + (on.length === 1 ? ' craft' : ' crafts') : 'Your evening'
    const body = 'Hi! Our picks for Dec 12 (Corky Child Care Collective): ' + (names.join(', ') || 'still deciding') + '.'
    $('textpicks').setAttribute('href', 'sms:+12564641710?&body=' + encodeURIComponent(body))
  }

  cards.forEach((c) => c.addEventListener('click', () => {
    c.setAttribute('aria-pressed', c.getAttribute('aria-pressed') === 'true' ? 'false' : 'true')
    render()
  }))
  render()
</script>

<style>
  :global(body) { background: #efe6da; }
  .inv {
    --ink: #3d3229; --text: #4a403a; --muted: #6f635b; --gold: #c4a882; --brown: #7a4a2e; --paper: #fffdf9;
    max-width: 30rem; margin: 0 auto; padding: 0 1rem 3rem; color: var(--text); font-family: Inter, sans-serif;
    display: flex; flex-direction: column; align-items: center; overflow-x: hidden;
  }
  .kicker { margin: 0; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase; color: #8a6a4c; }
  .kicker.center { text-align: center; }
  .kicker.light { color: #e2bf96; }

  .polaroids { position: relative; width: 100%; max-width: 24rem; height: 16.5rem; margin-top: 1.25rem; }
  .pol { position: absolute; width: 9.6rem; height: 11.6rem; object-fit: cover; border: 0.5rem solid #fff; box-shadow: 0 0.75rem 1.75rem rgba(61,50,41,0.22); animation: drop 0.9s cubic-bezier(.2,.8,.2,1) both; }
  .p1 { left: 0; top: 1.4rem; transform: rotate(-7deg); animation-delay: 0.05s; }
  .p2 { left: 50%; top: 3.2rem; margin-left: -4.8rem; transform: rotate(3deg); z-index: 1; animation-delay: 0.2s; }
  .p3 { right: 0; top: 0.8rem; transform: rotate(8deg); animation-delay: 0.35s; }
  @keyframes drop { from { opacity: 0; translate: 0 -1.5rem; } to { opacity: 1; translate: 0 0; } }

  .card { width: 100%; margin-top: -1.5rem; position: relative; z-index: 2; background: var(--paper); border-radius: 6px; box-shadow: 0 1.1rem 3rem rgba(61,50,41,0.16); padding: 0.6rem; }
  .frame { border: 1px solid var(--gold); outline: 1px solid var(--gold); outline-offset: -6px; padding: 2.25rem 1.5rem 1.9rem; display: flex; flex-direction: column; align-items: center; gap: 0.85rem; text-align: center; }
  h1 { margin: 0; font-family: 'Playfair Display', serif; font-style: italic; font-weight: 500; font-size: clamp(2.2rem, 9vw, 2.75rem); line-height: 1.05; color: var(--ink); }
  .for { margin: 0; font-family: 'Playfair Display', serif; font-size: 1.15rem; color: var(--text); line-height: 1.35; }
  .when { margin: 0; font-size: 0.875rem; line-height: 1.6; color: var(--muted); }

  .note { margin: 2.5rem 0 0; font-family: 'Playfair Display', serif; font-style: italic; font-size: 1.3rem; line-height: 1.45; text-align: center; color: var(--ink); }

  .build { width: 100%; margin-top: 2.5rem; display: flex; flex-direction: column; align-items: center; gap: 0.75rem; }
  .lede { margin: 0; font-family: 'Playfair Display', serif; font-size: 1.15rem; text-align: center; color: var(--ink); }

  .grid { width: 100%; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
  .craft { appearance: none; border: 0; text-align: left; font: inherit; color: inherit; cursor: pointer; background: var(--paper); border-radius: 8px; padding: 0.5rem 0.5rem 0.75rem; box-shadow: 0 0.5rem 1.4rem rgba(61,50,41,0.10); display: flex; flex-direction: column; gap: 0.3rem; position: relative; outline: 2px solid transparent; transition: transform 0.15s ease, outline-color 0.15s ease, box-shadow 0.15s ease; }
  .craft:active { transform: scale(0.98); }
  .craft:focus-visible { outline-color: var(--brown); }
  .craft[aria-pressed='true'] { outline-color: var(--brown); box-shadow: 0 0.7rem 1.8rem rgba(122,74,46,0.22); }
  .ph { position: relative; display: block; }
  .ph img { display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 5px; }
  .tick { position: absolute; top: 0.4rem; right: 0.4rem; width: 1.75rem; height: 1.75rem; border-radius: 50%; display: grid; place-items: center; background: rgba(255,253,249,0.85); color: transparent; border: 1.5px solid rgba(61,50,41,0.25); transition: all 0.15s ease; }
  .craft[aria-pressed='true'] .tick { background: var(--brown); border-color: var(--brown); color: #fff; }
  .cname { font-family: 'Playfair Display', serif; font-size: 1.02rem; line-height: 1.2; color: var(--ink); margin-top: 0.2rem; }
  .cnote { font-size: 0.75rem; line-height: 1.35; color: var(--muted); }
    .cmeta { display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: 600; color: var(--brown); margin-top: 0.15rem; }

  .summary { width: 100%; margin-top: 1.25rem; position: sticky; bottom: 0.75rem; z-index: 5; background: var(--paper); border-radius: 10px; box-shadow: 0 0.9rem 2.5rem rgba(61,50,41,0.22); padding: 1rem 1.15rem 1.05rem; display: flex; flex-direction: column; gap: 0.75rem; border: 1px solid #eadcc9; }
  .time-row { display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--muted); }
  .time-row b { color: var(--ink); }
  .bar { height: 0.45rem; border-radius: 999px; background: #efe6da; overflow: hidden; margin-top: 0.35rem; }
  .fill { height: 100%; width: 0; border-radius: 999px; background: linear-gradient(90deg, #d4a574, #7a4a2e); transition: width 0.35s ease; }
  .fill.full { background: #b45309; }
  .over { margin: 0.4rem 0 0; font-size: 0.75rem; color: #9a3b0e; }
  .price { display: flex; flex-direction: column; gap: 0.2rem; border-top: 1px solid #efe4d6; padding-top: 0.6rem; }
  .row { display: flex; justify-content: space-between; align-items: baseline; }
  .muted { font-size: 0.8rem; color: var(--muted); }
  .strike { text-decoration: line-through; }
  .your { font-family: 'Playfair Display', serif; font-size: 1.15rem; color: var(--ink); }
  .your em { font-family: Inter, sans-serif; font-style: normal; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; color: var(--brown); background: #f6ead9; padding: 0.15rem 0.45rem; border-radius: 999px; margin-left: 0.3rem; vertical-align: middle; }
  .your em:empty { display: none; }
  .amt { font-family: 'Playfair Display', serif; font-weight: 600; font-size: 2.1rem; color: var(--brown); line-height: 1; }
  .amt small { font-family: Inter, sans-serif; font-weight: 400; font-size: 0.8rem; color: var(--muted); }
  .save { margin: 0.15rem 0 0; font-size: 0.8rem; color: var(--brown); font-weight: 600; text-align: right; }
  .picked { margin: 0; font-size: 0.75rem; color: var(--muted); text-align: right; }

  .photos { width: 100%; margin-top: 1.75rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.4rem; }
  .photos img { width: 100%; height: 7rem; object-fit: cover; border-radius: 6px; }

  .included { width: 100%; margin-top: 1.75rem; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
  .included div { padding: 1.1rem 0.8rem; border-radius: 6px; background: rgba(255,253,249,0.7); display: flex; flex-direction: column; align-items: center; gap: 0.5rem; text-align: center; font-size: 0.875rem; color: var(--ink); }

  .steps { width: 100%; margin-top: 2.25rem; display: flex; flex-direction: column; gap: 1rem; }
  .steps ol { margin: 0; padding: 0; list-style: none; counter-reset: s; display: flex; flex-direction: column; gap: 0.9rem; }
  .steps li { counter-increment: s; display: grid; grid-template-columns: 2.1rem 1fr; gap: 0.75rem; align-items: center; font-size: 0.95rem; line-height: 1.45; }
  .steps li::before { content: counter(s); width: 2.1rem; height: 2.1rem; border-radius: 50%; border: 1px dashed var(--gold); display: grid; place-items: center; font-family: 'Playfair Display', serif; font-style: italic; color: var(--brown); }
  .steps b { color: var(--ink); font-weight: 600; }

  .reserve { width: 100%; margin-top: 2.25rem; padding: 1.6rem 1.35rem; background: var(--ink); border-radius: 6px; display: flex; flex-direction: column; align-items: center; gap: 0.85rem; text-align: center; box-shadow: 0 1.1rem 2.75rem rgba(61,50,41,0.3); }
  .sum { margin: 0; font-family: 'Playfair Display', serif; font-size: 1.3rem; color: #faf8f5; }
  .btn { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 3.5rem; border-radius: 999px; background: #f1d7b6; color: var(--ink); font-weight: 600; font-size: 1.05rem; text-decoration: none; transition: transform 0.15s ease, box-shadow 0.15s ease; box-shadow: 0 0.4rem 1.2rem rgba(0,0,0,0.25); }
  .btn.ghost { background: transparent; color: #f1d7b6; border: 1.5px solid rgba(241,215,182,0.5); box-shadow: none; min-height: 3rem; font-size: 0.95rem; }
  .btn:hover { transform: translateY(-1px); }
  .btn:focus-visible { outline: 3px solid #f1d7b6; outline-offset: 3px; }
  .fine { margin: 0; font-size: 0.75rem; line-height: 1.5; color: #d9cfc4; }
  .fine a { color: #f1d7b6; }

  .sign { margin-top: 2.25rem; display: flex; flex-direction: column; align-items: center; gap: 0.35rem; text-align: center; }
  .sign p { margin: 0; font-size: 0.85rem; color: var(--muted); }
  .sign .love { font-family: 'Playfair Display', serif; font-style: italic; font-size: 1.25rem; color: var(--brown); }
  .sign a { color: var(--brown); }

  @media (prefers-reduced-motion: reduce) { .pol { animation: none; } .fill { transition: none; } }
</style>
