---
// src/pages/admin/magnets-print.astro
export const prerender = false
import { adminAuthorized } from '@lib/admin-auth'
import { getOrder, isReference } from '@lib/magnet-orders'
import { layoutSheets, framePolygon, printItems, SHEET, EDGE_LABEL } from '@lib/magnet-sheet'

if (!adminAuthorized(Astro.request)) return Astro.redirect('/admin')
// ?id=M-XXXXXX (one order) or ?ids=M-AAA,M-BBB (a batch, printed back to back)
const wanted = (Astro.url.searchParams.get('ids') ?? Astro.url.searchParams.get('id') ?? '').split(',').map((s) => s.trim()).filter(isReference).slice(0, 30)
const found = (await Promise.all(wanted.map((id) => getOrder(id)))).filter((o) => o !== null)
if (!found.length) return new Response('Order not found', { status: 404 })
const orders = found.filter((o) => !o.photosDeletedAt)
const skipped = found.filter((o) => o.photosDeletedAt)
const pages = layoutSheets(printItems(orders))
// the photo fills the whole cut shape, so its edge IS the cut line (no border, no white band)
const clip = `polygon(${framePolygon().map(([x, y]) => `${(x / SHEET.frame) * 100}% ${(y / SHEET.frame) * 100}%`).join(', ')})`
const src = (draftId: string, photoId: string) => `/api/admin/magnet-photo?draft=${draftId}&photo=${photoId}`
const magnets = orders.reduce((n, o) => n + o.magnets.length, 0)
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex" />
  <title>Print {orders.map((o) => o.id).join(', ')}</title>
  <style define:vars={{ pageW: `${SHEET.pageW}in`, pageH: `${SHEET.pageH - 0.01}in`, frame: `${SHEET.frame}in`, inset: `${SHEET.photoInset}in`, photo: `${SHEET.photo}in`, clip, labelTop: `${EDGE_LABEL.top}in`, labelH: `${EDGE_LABEL.height}in`, labelPt: `${EDGE_LABEL.fontPt}pt`, labelColor: EDGE_LABEL.color }}>
    @page { size: letter; margin: 0; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: system-ui, sans-serif; background: #eee; }
    .bar { padding: 12px 16px; display: flex; gap: 12px; align-items: center; background: #fff; border-bottom: 1px solid #ddd; }
    .bar button { font-size: 18px; padding: 10px 22px; border-radius: 10px; border: 0; background: #7a4a2e; color: #fff; }
    .sheet { position: relative; width: var(--pageW); height: var(--pageH); margin: 16px auto; background: #fff; overflow: hidden; break-after: page; }
    .sheet:last-of-type { break-after: auto; }
    .cell { position: absolute; width: var(--frame); height: var(--frame); }
    .cell img { position: absolute; inset: 0; width: var(--frame); height: var(--frame); object-fit: cover; clip-path: var(--clip); }
    .cell .code { -webkit-print-color-adjust: exact; print-color-adjust: exact; position: absolute; left: var(--inset); width: var(--photo); top: var(--labelTop); height: var(--labelH); line-height: var(--labelH); font-size: var(--labelPt); color: var(--labelColor); text-align: center; white-space: nowrap; overflow: hidden; }
    .cell .code span { background: #fff; padding: 0 0.03in; }
    .key { font-size: 14px; color: #444; }
    @media print { body { background: #fff; } .bar { display: none; } .sheet { margin: 0; } }
  </style>
</head>
<body>
  <div class="bar">
    <button type="button" id="print" disabled onclick="window.print()">Loading photos…</button>
    <span>{magnets} magnets · {pages.length} page{pages.length === 1 ? '' : 's'}. Print at Actual size (100%).</span>
  </div>
  <div class="bar key">
    {orders.map((o) => <span>{o.id} · {o.contact.name} · {o.magnets.length}</span>)}
    {skipped.length > 0 && <span>Not printed (photos deleted): {skipped.map((o) => o.id).join(', ')}</span>}
  </div>
  {pages.map((cells) => (
    <section class="sheet">
      {cells.map((c) => (
        <div class="cell" style={`left:${c.left}in;top:${c.top}in`}>
          <img src={src(c.item.draftId, c.item.photoId)} alt="" />
          <div class="code"><span>{c.item.label}</span></div>
        </div>
      ))}
    </section>
  ))}
  <script is:inline>
    (function () {
      var btn = document.getElementById('print')
      var imgs = Array.prototype.slice.call(document.querySelectorAll('.cell img'))
      var ready = function () { btn.disabled = false; btn.textContent = 'Print' }
      Promise.all(imgs.map(function (i) { return i.complete ? 0 : new Promise(function (r) { i.onload = i.onerror = r }) })).then(ready)
    })()
  </script>
</body>
</html>
