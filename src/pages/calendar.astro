---
export const prerender = false

import Layout from '@layouts/Layout.astro'
import WhatsOnCalendar from '@components/calendar/WhatsOnCalendar'

// Events are fetched per-month, client-side, from /api/calendar.json?month=YYYY-MM
// (one month at a time keeps each Square availability query under the 32-day cap).
---

<Layout title="Calendar" description="Upcoming workshops, party dates, and events at Hometown Studio">
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-28">
    <div class="text-center mb-16 fade-in">
      <p class="eyebrow tone-event mb-3">Calendar</p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-bold" style="color: var(--color-dark);">Coming up at the studio</h1>
      <p class="text-lg mt-4 max-w-xl mx-auto" style="color: var(--color-muted);">
        Workshops, open studio hours, and open party dates — tap anything to grab your spot
      </p>
    </div>
    <WhatsOnCalendar client:load />
  </section>
</Layout>
