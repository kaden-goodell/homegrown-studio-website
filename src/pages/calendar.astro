---
export const prerender = false

import Layout from '@layouts/Layout.astro'
import WhatsOnCalendar from '@components/calendar/WhatsOnCalendar'
import { envBookingsOpen, hasValidPreviewCookie, previewQueryMatches } from '@lib/bookings-gate'

// Only promise "tap to book" when tapping can actually book.
const preview = previewQueryMatches(Astro.url) || hasValidPreviewCookie(Astro.request)
const partiesOpen = envBookingsOpen('parties') || preview
const workshopsOpen = envBookingsOpen('workshops') || preview

// Events are fetched per-month, client-side, from /api/calendar.json?month=YYYY-MM
// (one month at a time keeps each Square availability query under the 32-day cap).
---

<Layout title="Calendar" description="Upcoming workshops and open party dates at Hometown Studio in Madison, AL.">
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-28">
    <div class="text-center mb-16 fade-in">
      <p class="eyebrow tone-event mb-3">Calendar</p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-bold" style="color: var(--color-dark);">Coming up at the studio</h1>
      <p class="text-lg mt-4 max-w-xl mx-auto" style="color: var(--color-muted);">
        {partiesOpen && workshopsOpen
          ? 'Workshops and open party dates. Tap one to book it.'
          : partiesOpen
            ? 'Open party dates and upcoming workshops. Tap a party date to book it. Workshop booking opens with our grand opening.'
            : 'Here’s what’s coming. Booking opens with our grand opening, and you can ask to be told the day it does.'}
      </p>
    </div>
    <WhatsOnCalendar client:load />
  </section>
</Layout>
