---
export const prerender = false

import Layout from '@layouts/Layout.astro'
import WaiverFlow from '@components/waiver/WaiverFlow'
import { waiverContent } from '@config/waiver-content'
import { getEvent, isEventPast, type StudioEvent } from '@lib/events'
import { formatWhen } from '@lib/studio-time'
import { safeReturnPath } from '@lib/safe-return'

// Kiosk mode (HOM-209): the shared staff iPad at the counter, opened via
// Today's "Sign on this iPad". Skips the returning-customer lookup, shows a
// slim disclosure bar, and auto-returns to `return` (validated same-origin —
// never trust it as-is) after signing.
const kiosk = Astro.url.searchParams.get('kiosk') === '1'
const returnTo = safeReturnPath(Astro.url.searchParams.get('return'))

const rawPartyId = Astro.url.searchParams.get('party') ?? undefined
const rawWorkshopId = !rawPartyId ? (Astro.url.searchParams.get('workshop') ?? undefined) : undefined
// The per-seat Square booking id (workshops only) — carried through to the
// RSVP as `ref.bookingId` so staff can trace a signature to its seat.
const rawBooking = rawWorkshopId ? (Astro.url.searchParams.get('booking') ?? undefined) : undefined
const { page } = waiverContent
const subline = rawPartyId ? page.partySubline : page.subline

// When a party or workshop param is present, resolve it server-side (party
// takes precedence if somehow both are given). Four outcomes:
//   1. found + not past  → pass id + label
//   2. found + past      → block RSVP with a notice, no id
//   3. returned null     → unrecognised id — show warning, no id (prevents ghost RSVPs)
//   4. threw             → transient storage error — keep id, no label

type EventOutcome =
  | { kind: 'ok';      id: string; label: string; dropOff: boolean }
  | { kind: 'past';    notice: string }
  | { kind: 'unknown'; notice: string }
  | { kind: 'error';   id: string }
  | { kind: 'none' }

const rawId = rawPartyId ?? rawWorkshopId
const eventKind = rawPartyId ? 'party' as const : rawWorkshopId ? 'workshop' as const : null
let outcome: EventOutcome = { kind: 'none' }

if (eventKind && rawId) {
  try {
    const event: StudioEvent | null = await getEvent(eventKind, rawId)
    if (event === null) {
      // Genuinely unknown id — bad/stale link.
      outcome = {
        kind: 'unknown',
        notice: eventKind === 'party'
          ? 'That party link wasn’t recognized — ask your host for a fresh invitation. You can still sign the general agreement below.'
          : 'That link wasn’t recognized — ask the studio for a fresh link. You can still sign the general agreement below.',
      }
    } else {
      // Days-based rule, aligned with sign.json's server-side validateEvent
      // (Task 2 deferred item): past once every day of the event is before
      // yesterday (studio-local), not a flat 24h window off startIso.
      const isPast = isEventPast(event)
      if (isPast) {
        outcome = { kind: 'past', notice: 'This event has already happened.' }
      } else {
        const label = `${event.title} · ${formatWhen(event.startIso)} CT`
        outcome = { kind: 'ok', id: rawId, label, dropOff: event.dropOff }
      }
    }
  } catch {
    // Transient storage error — keep the id so a valid RSVP link still works;
    // sign.json re-validates anyway. No label since we have no record.
    outcome = { kind: 'error', id: rawId }
  }
}

const flowPartyId    = eventKind === 'party' && (outcome.kind === 'ok' || outcome.kind === 'error') ? outcome.id : undefined
const flowWorkshopId = eventKind === 'workshop' && (outcome.kind === 'ok' || outcome.kind === 'error') ? outcome.id : undefined
const flowPartyLabel = eventKind === 'party' && outcome.kind === 'ok' ? outcome.label : undefined
const flowEventTitle = eventKind === 'workshop' && outcome.kind === 'ok' ? outcome.label : undefined
// On a storage error we kept the id (the RSVP still works, sign.json
// re-validates) but had no idea whether the event is drop-off — and
// `undefined` meant the drop-off fields (pickup, medications) never
// rendered. Assume drop-off: asking a non-drop-off event for them is
// harmless, the reverse is not.
const flowDropOff    = outcome.kind === 'ok' ? outcome.dropOff : outcome.kind === 'error' ? true : undefined
const noticeText     = outcome.kind === 'unknown' || outcome.kind === 'past' ? (outcome as { notice: string }).notice : null
---

<Layout
  title="Participation Agreement"
  description="Sign the Hometown Studio participation agreement — each adult signs for themselves and their own kids, good for a full year."
  noindex={kiosk}
>
  <section class="max-w-2xl mx-auto px-4 sm:px-6 py-28">
    <div class="text-center mb-10 fade-in">
      <p class="eyebrow mb-3">
        {page.eyebrow}
      </p>
      <h1 class="text-3xl sm:text-4xl font-heading font-bold" style="color: var(--color-dark);">
        {page.headline}
      </h1>
      <p class="text-base mt-4 max-w-lg mx-auto" style="color: var(--color-muted);">
        {subline}
      </p>
    </div>

    {noticeText && (
      <div
        style="
          background: rgba(217, 119, 6, 0.08);
          border: 1px solid rgba(217, 119, 6, 0.28);
          border-radius: 0.875rem;
          padding: 0.9rem 1.15rem;
          margin-bottom: 1.5rem;
          font-size: 0.9375rem;
          color: var(--color-dark);
          line-height: 1.5;
          backdrop-filter: blur(8px);
          -webkit-backdrop-filter: blur(8px);
        "
      >
        {noticeText}
      </div>
    )}

    <WaiverFlow client:load partyId={flowPartyId} partyLabel={flowPartyLabel} workshopId={flowWorkshopId} eventTitle={flowEventTitle} dropOff={flowDropOff} booking={rawBooking} kiosk={kiosk} returnTo={returnTo} />
  </section>
</Layout>
