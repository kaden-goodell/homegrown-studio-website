---
export const prerender = true

import Layout from '@layouts/Layout.astro'
import ContactForm from '@components/contact/ContactForm'
import { siteConfig } from '@config/site.config'
---

<Layout
  title="Contact"
  description="Questions about a workshop, a party, or Craft Café at Hometown Studio in Madison, AL? Send us a note."
>
  <section class="max-w-2xl mx-auto px-4 sm:px-6 pb-20" style="padding-top: 5.5rem;">
    <div class="mb-6 md:text-center fade-in">
      <p class="eyebrow tone-event mb-2">Contact</p>
      <h1 class="text-4xl sm:text-5xl font-heading font-bold" style="color: var(--color-dark);">Get in touch</h1>
      <p class="text-base sm:text-lg mt-3" style="color: var(--color-text);">
        Questions about a workshop, a party, or anything else? Send us a note and we’ll get back to you.
      </p>
      <p class="text-sm mt-3" style="color: var(--color-muted);">
        {siteConfig.contactPhone && <Fragment>Rather text? {siteConfig.contactPhone}. </Fragment>}
        Planning an event? <a href="/private-events" style="color: var(--color-primary); text-decoration: underline;">Tell us about it here</a>.
      </p>
    </div>
    <ContactForm client:load />
  </section>
</Layout>
